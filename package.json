{
  "name": "navblog",
  "version": "1.0.0",
  "description": "NavBlog —— 纯静态、却能在线进入后台编辑的个人博客系统，Fuwari 风格主题（基于 xjh22222228/nav 改造，GPL-3.0）",
  "homepage": "https://github.com/dragonadd/Navblog",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dragonadd/Navblog.git"
  },
  "bugs": {
    "url": "https://github.com/dragonadd/Navblog/issues"
  },
  "keywords": [
    "blog",
    "static-site",
    "markdown",
    "angular",
    "tailwindcss",
    "giscus",
    "fuwari",
    "github-pages"
  ],
  "author": "dragonadd",
  "license": "GPL-3.0",
  "type": "module",
  "scripts": {
    "setup": "tsx ./scripts/init.ts",
    "prepare-data": "tsx ./scripts/prepare.ts",
    "start": "tsx ./scripts/prepare.ts && ng serve --host 0.0.0.0 --port=7002",
    "build": "tsx ./scripts/prepare.ts && ng build && tsx ./scripts/postbuild.ts",
    "build-gh-pages": "pnpm run build",
    "preview": "tsx ./scripts/preview.ts",
    "new": "tsx ./scripts/new-post.ts",
    "format": "prettier --write \"**/*.{ts,html,css,json}\""
  },
  "dependencies": {
    "@angular/common": "^21.0.6",
    "@angular/compiler": "^21.0.6",
    "@angular/core": "^21.0.6",
    "@angular/forms": "^21.0.6",
    "@angular/platform-browser": "^21.0.6",
    "@angular/router": "^21.0.6",
    "@fortawesome/fontawesome-free": "^6.7.2",
    "highlight.js": "^11.11.1",
    "js-base64": "^3.7.8",
    "js-yaml": "^4.1.1",
    "marked": "^15.0.12",
    "marked-highlight": "^2.2.1",
    "rxjs": "~7.8.2",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^21.0.4",
    "@angular/cli": "^21.0.4",
    "@angular/compiler-cli": "^21.0.6",
    "@tailwindcss/postcss": "^4.1.18",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.10.0",
    "postcss": "^8.5.6",
    "prettier": "^3.7.4",
    "tailwindcss": "^4.1.18",
    "tsx": "^4.21.0",
    "typescript": "~5.9.3"
  }
}
